{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
        "meta": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && data.exists() && newData.exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          ".validate": "newData.hasChild('ownerUid') && newData.child('ownerUid').isString() && newData.child('ownerUid').val() == data.child('ownerUid').val() && newData.child('ownerUid').val() == root.child('roomAccess').child($roomId).child('ownerUid').val()",
          "ownerUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "destination": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "startDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "endDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
        },
        "itinerary": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('rooms').child($roomId).child('meta').exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          "$dayId": {
            ".validate": "newData.hasChildren()",
            "$itemId": {
              ".validate": "newData.hasChildren()",
              "$field": {
                ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)",
                "$nestedField": {
                  ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)"
                }
              }
            }
          }
        },
        "expenses": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('rooms').child($roomId).child('meta').exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          "$expenseId": {
            ".validate": "newData.hasChildren()",
            "$field": { ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)" }
          }
        },
        "settlements": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('rooms').child($roomId).child('meta').exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          "$settlementId": {
            ".validate": "newData.hasChildren()",
            "$field": { ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)" }
          }
        },
        "tickets": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('rooms').child($roomId).child('meta').exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          "$ticketId": {
            ".validate": "newData.hasChildren()",
            "$field": { ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)" }
          }
        },
        "checklist": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('rooms').child($roomId).child('meta').exists() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('uid').val() == auth.uid && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').isNumber() && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('aclVersion').val() > 0 && root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('status').val() == 'active' && (root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'owner' || root.child('roomAccess').child($roomId).child('members').child(auth.uid).child('role').val() == 'editor')",
          "$checklistId": {
            ".validate": "newData.hasChildren()",
            "$field": { ".validate": "newData.hasChildren() || newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 10000)" }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomAccess": {
      "$roomId": {
        "members": {
          "$memberUid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $memberUid && data.child('uid').val() == auth.uid && data.child('aclVersion').isNumber() && data.child('aclVersion').val() > 0",
            ".write": false
          }
        },
        "$other": {
          ".read": false,
          ".write": false
        }
      }
    },
    "userTrips": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        ".write": false
      }
    },
    "roomReservations": {
      "$roomId": {
        ".read": false,
        ".write": false
      }
    },
    "tripInvites": {
      "$tokenHash": {
        ".read": false,
        ".write": false
      }
    }
  }
}
